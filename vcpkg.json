{
  "name": "vectorlite",
  "version-string": "0.3.0",
  "description": "Rust SQLite extension with native HNSW and SIMD kernels",
  "license": "Apache-2.0",
  "builtin-baseline": "6d7bf7ef2193e2d1c5798a5ff8811d533104c861",
  "dependencies": [
    {
      "name": "hnswlib",
      "version>=": "0.8.0"
    },
    {
      "name": "highway",
      "features": [
        "contrib"
      ],
      "version>=": "1.3.0"
    }
  ],
  "features": {
    "tests": {
      "description": "Native SIMD unit tests and SQLite extension-API ABI checks",
      "dependencies": [
        {
          "name": "gtest",
          "version>=": "1.17.0"
        },
        {
          "name": "sqlite3",
          "version>=": "3.51.2"
        }
      ]
    },
    "benchmarks": {
      "description": "Native SIMD microbenchmarks",
      "dependencies": [
        {
          "name": "benchmark",
          "version>=": "1.9.5"
        }
      ]
    }
  }
}
